{
  "name": "hookachu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 127.0.0.1",
    "build": "vite build",
    "start": "npm run dev",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "start:self-hosted": "node scripts/serve.mjs",
    "format": "prettier --write \"**/*.{vue,js,mjs,css,html}\"",
    "format:check": "prettier --check \"**/*.{vue,js,mjs,css,html}\""
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^14.0.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261103.0-beta",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "description": "Open-source, self-hosted webhook inbox with live request inspection and automatic expiry.",
  "repository": {
    "type": "git",
    "url": "https://github.com/h2u/hookachu.git"
  }
}
