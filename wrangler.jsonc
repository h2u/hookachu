{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hookachu",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/h/*", "/healthz"] },
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "Inbox" }, { "name": "ADMISSION", "class_name": "Admission" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox", "Admission"] }],
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": false },
  "vars": { "MAX_INBOXES": "200" }
}
